#!/usr/bin/env bash
# ==============================================================================
# ⚡ Caelestia Fast CLI Dispatcher
# Direct zero-overhead IPC calls for instantaneous UI response (<10ms)
# ==============================================================================

case "$1" in
    dashboard|launcher|session|sidebar|utilities)
        exec qs -c caelestia ipc call drawers toggle "$1"
        ;;
    toggle)
        exec qs -c caelestia ipc call drawers toggle "${2:-launcher}"
        ;;
    nexus)
        exec qs -c caelestia ipc call nexus open "${2:-}"
        ;;
    toast)
        ttype="${2:-info}"
        title="${3:-Caelestia}"
        msg="${4:-}"
        icon="${5:-spark}"
        exec qs -c caelestia ipc call toaster "$ttype" "$title" "$msg" "$icon"
        ;;
    shell)
        case "${2:-}" in
            -k|--kill) exec systemctl --user stop caelestia-shell ;;
            -r|--restart|"") exec systemctl --user restart caelestia-shell ;;
            -l|--log) exec journalctl --user -u caelestia-shell -f ;;
            -s|--show) exec qs -c caelestia ipc call drawers list ;;
        esac
        ;;
    *)
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        exec python3 -S "$SCRIPT_DIR/caelestia.py" "$@"
        ;;
esac
