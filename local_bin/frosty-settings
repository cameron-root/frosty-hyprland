    def set_accent(self, color):
        run_cmd(f"{SET_ACCENT_SH} {color}")
        self.blue_check.set_visible(color == "blue")
        self.red_check.set_visible(color == "red")
        if color == "blue":
            self.btn_blue.set_css_classes(["pill", "suggested-action"])
            self.btn_red.set_css_classes(["pill"])
        else:
            self.btn_blue.set_css_classes(["pill"])
            self.btn_red.set_css_classes(["pill", "destructive-action"])

