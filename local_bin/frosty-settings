HOME = Path.home()
CONFIG_DIR = HOME / ".config"
HYPR_DIR = CONFIG_DIR / "hypr"
USER_DECOR = HYPR_DIR / "UserConfigs/UserDecorations.conf"
ACCENT_CONF = HYPR_DIR / "UserConfigs/Accent.conf"
ACCENT_STATE = HOME / ".local/state/accent.txt"
SHELL_JSON = CONFIG_DIR / "caelestia/shell.json"
SET_ACCENT_SH = HYPR_DIR / "scripts/SetAccent.sh"
SNAPSHOTS_DIR = HOME / ".snapshots"

def run_cmd(cmd, check=False):
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, check=check)
        return res.stdout.strip()
    except Exception as e:
        return ""

def hyprctl_keyword(key, val):
    run_cmd(f"hyprctl keyword {key} {val}")

class FrostySettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="io.caelestia.frosty_settings",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = FrostySettingsWindow(application=self)
        win.present()

class FrostySettingsWindow(Adw.PreferencesWindow):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.set_title("Frosty Settings")
        self.set_default_size(860, 680)
        self.set_search_enabled(True)

        self.decor_data = self.read_decor_conf()
        self.shell_data = self.read_shell_json()

        # Build Pages
        self.build_appearance_page()
        self.build_blur_page()
        self.build_windows_page()
        self.build_animations_page()
        self.build_caelestia_page()
        self.build_snapshots_page()
        self.build_tools_page()

    # ── Helpers for Reading & Writing Configs ──────────────────────────────
    def read_decor_conf(self):
        content = ""
        if USER_DECOR.exists():
            content = USER_DECOR.read_text()

        def get_val(pattern, default, conv=str):
            m = re.search(pattern, content)
            if m:
                try:
                    return conv(m.group(1))
                except Exception:
                    pass
            return default

        return {
            "rounding": get_val(r"rounding\s*=\s*(\d+)", 18, int),
            "active_opacity": get_val(r"active_opacity\s*=\s*([0-9.]+)", 0.94, float),
            "inactive_opacity": get_val(r"inactive_opacity\s*=\s*([0-9.]+)", 0.85, float),
            "dim_inactive": get_val(r"dim_inactive\s*=\s*(true|false)", "true") == "true",
            "dim_strength": get_val(r"dim_strength\s*=\s*([0-9.]+)", 0.08, float),
            "blur_enabled": get_val(r"blur\s*\{[^}]*enabled\s*=\s*(true|false)", "true") == "true",
            "blur_size": get_val(r"blur\s*\{[^}]*size\s*=\s*(\d+)", 7, int),
            "blur_passes": get_val(r"blur\s*\{[^}]*passes\s*=\s*(\d+)", 3, int),
            "blur_vibrancy": get_val(r"blur\s*\{[^}]*vibrancy\s*=\s*([0-9.]+)", 0.24, float),
            "blur_contrast": get_val(r"blur\s*\{[^}]*contrast\s*=\s*([0-9.]+)", 1.06, float),
            "blur_noise": get_val(r"blur\s*\{[^}]*noise\s*=\s*([0-9.]+)", 0.012, float),
            "shadow_enabled": get_val(r"shadow\s*\{[^}]*enabled\s*=\s*(true|false)", "true") == "true",
            "shadow_range": get_val(r"shadow\s*\{[^}]*range\s*=\s*(\d+)", 28, int),
            "gaps_in": get_val(r"gaps_in\s*=\s*(\d+)", 6, int),
            "gaps_out": get_val(r"gaps_out\s*=\s*(\d+)", 8, int),
            "border_size": get_val(r"border_size\s*=\s*(\d+)", 1, int),
        }

    def save_decor_param(self, pattern, replacement):
        if not USER_DECOR.exists():
            return
        content = USER_DECOR.read_text()
        new_content = re.sub(pattern, replacement, content)
        USER_DECOR.write_text(new_content)

    def read_shell_json(self):
        try:
            return json.loads(SHELL_JSON.read_text())
        except Exception:
            return {
                "appearance": {
                    "transparency": {"enabled": True, "base": 0.52, "layers": 0.26},
                    "rounding": {"scale": 1.3}
                },
                "osd": {"enabled": True, "hideDelay": 2000}
            }

    def save_shell_json(self):
        try:
            SHELL_JSON.write_text(json.dumps(self.shell_data, indent=4))
        except Exception as e:
            print("Error saving shell.json:", e)

    def get_current_accent(self):
        if ACCENT_STATE.exists():
            return ACCENT_STATE.read_text().strip()
        return "blue"

