        save_btn = Gtk.Button(label="💾  Take Snapshot")
        save_btn.set_css_classes(["pill"])
        save_btn.connect("clicked", lambda b: self.on_take_snapshot(create_row.get_text()))
        create_row.add_suffix(save_btn)
        snap_group.add(create_row)

        # Saved Archives Row
        self.snap_list_group = Adw.PreferencesGroup(title="Saved Snapshots on Disk")
        page.add(self.snap_list_group)
        self.refresh_snapshots_list()

    def refresh_snapshots_list(self):
        # List items in ~/.snapshots
        if not SNAPSHOTS_DIR.exists():
            return
        snaps = sorted([f.name for f in SNAPSHOTS_DIR.iterdir()])
        for snap in snaps:
            row = Adw.ActionRow(title=snap)
            if (SNAPSHOTS_DIR / snap).is_dir():
                row.set_subtitle("Directory Snapshot")
            else:
                row.set_subtitle("Compressed Archive (.tar.gz)")
            self.snap_list_group.add(row)

    def on_restore_snapshot(self, btn):
        restore_script = SNAPSHOTS_DIR / "frosty-hyprland/restore.sh"
        if restore_script.exists():
            run_cmd(str(restore_script))
            run_cmd("caelestia toast success 'Restored' 'Frosty Hyprland restored successfully!'")

    def on_take_snapshot(self, name):
        name = name.strip() or "frosty-snapshot"
        target_dir = SNAPSHOTS_DIR / name
        run_cmd(f"mkdir -p '{target_dir}/configs'")
        run_cmd(f"cp -a ~/.config/hypr '{target_dir}/configs/'")
        run_cmd(f"cp -a ~/.config/caelestia '{target_dir}/configs/' 2>/dev/null || true")
        run_cmd(f"cp -a ~/.config/kitty '{target_dir}/configs/' 2>/dev/null || true")
        run_cmd(f"cp -a ~/.config/gtk-3.0 '{target_dir}/configs/' 2>/dev/null || true")
        run_cmd(f"cp -a ~/.config/gtk-4.0 '{target_dir}/configs/' 2>/dev/null || true")
        run_cmd(f"tar -czvf '{SNAPSHOTS_DIR}/{name}.tar.gz' -C '{SNAPSHOTS_DIR}' '{name}'")
        run_cmd(f"caelestia toast success 'Snapshot Created' 'Snapshot {name} saved successfully!'")

