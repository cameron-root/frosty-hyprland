    def on_anim_preset_selected(self, row, param):
        idx = row.get_selected()
        preset_files = [
            "00-default.conf",
            "ML4W - dynamic.conf",
            "HYDE - optimized.conf",
            "ML4W - classic.conf",
            "03- Disable Animation.conf"
        ]
        chosen = preset_files[min(idx, len(preset_files)-1)]
        src = HYPR_DIR / f"animations/{chosen}"
        dst = HYPR_DIR / "UserConfigs/UserAnimations.conf"
        if src.exists():
            dst.write_text(f"# Sourced from {chosen}\n" + src.read_text())
