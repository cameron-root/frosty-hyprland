    # ── Page 6: Snapshots & Backups ───────────────────────────────────────
    def build_snapshots_page(self):
        page = Adw.PreferencesPage(
            title="Snapshots",
            icon_name="document-save-symbolic"
        )
        self.add(page)

        snap_group = Adw.PreferencesGroup(
            title="Frosty Hyprland Snapshot Engine",
            description="Create and restore full dotfile state snapshots anytime"
        )
        page.add(snap_group)

        # Active Snapshot Row
        curr_snap_row = Adw.ActionRow(title="Active Snapshot", subtitle="frosty hyprland (Created 2026-10-02)")
        restore_btn = Gtk.Button(label="⚡  Restore Frosty Hyprland")
        restore_btn.set_css_classes(["pill", "suggested-action"])
        restore_btn.connect("clicked", self.on_restore_snapshot)
        curr_snap_row.add_suffix(restore_btn)
        snap_group.add(curr_snap_row)

        # Create New Snapshot
        create_row = Adw.EntryRow(title="New Snapshot Name")
