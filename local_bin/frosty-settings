def main():
    if "--gtk" not in sys.argv:
        try:
            caelestia_bin = shutil.which("caelestia") or os.path.expanduser("~/.local/bin/caelestia")
            res = subprocess.run([caelestia_bin, "nexus", "frosty"], check=False)
            if res.returncode == 0:
                return 0
        except Exception:
            pass
    app = FrostySettingsApp()
    return app.run([arg for arg in sys.argv if arg != "--gtk"])

if __name__ == "__main__":
    sys.exit(main())
