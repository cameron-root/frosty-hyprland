#!/usr/bin/env bash
# ==============================================================================
# ☕ Caelestia Keep Awake Inhibitor Daemon
# Freezes hypridle timers and holds systemd-inhibit lock
# ==============================================================================

INHIBIT_PID=""

cleanup() {
    trap - SIGINT SIGTERM SIGHUP EXIT
    # 1. Resume hypridle if it was paused
    pkill -CONT -x hypridle 2>/dev/null || true
    # If hypridle died, restart it in background
    if ! pgrep -x hypridle >/dev/null; then
        hypridle >/dev/null 2>&1 &
        disown
    fi
    # 2. Terminate background systemd-inhibit
    if [[ -n "$INHIBIT_PID" ]]; then
        kill -TERM "$INHIBIT_PID" 2>/dev/null || true
        wait "$INHIBIT_PID" 2>/dev/null || true
    fi
    exit 0
}

trap cleanup SIGINT SIGTERM SIGHUP EXIT

# 1. Freeze hypridle so no idle countdowns or lock triggers can fire
pkill -STOP -x hypridle 2>/dev/null || true

# 2. Block systemd/logind from sleeping or idling
systemd-inhibit --what=idle:sleep --who="Caelestia Keep Awake" --why="User enabled Keep Awake" sleep infinity &
INHIBIT_PID=$!

wait "$INHIBIT_PID"
cleanup
