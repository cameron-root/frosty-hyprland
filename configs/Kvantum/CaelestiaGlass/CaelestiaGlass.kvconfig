[%General]
author=Caelestia
comment=iOS Frosted Glass - Caelestia Desktop Theme
email=
url=
x11drag=all
alt_mnemonic=true
animate=true
animation=70
no_window_pattern=false
composite=true
reduce_window_opacity=0
reduce_menu_opacity=0
shadowless_popup=false
popup_blurring=true
opaque_possible_translucent=false
menu_shadow_depth=6
spread_shadow=true
shadow_color=#000000
overlay_color=#007388b7
overlay_opacity=0
center_toolbar_handle=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=24
combo_as_lineedit=false
button_contents_shift=false
hide_combo_checkboxes=false
inline_spin_indicators=true
vertical_spin_indicators=false
groupbox_top_label=false
combo_menu=false
combo_focus_rect=false
scrollbar_in_view=false
transient_scrollbar=false
transient_groove=false
scroll_arrows=false
drag_from_buttons=false
middle_click_scroll=false
scroll_min_extent=36
slim_combo=false
respect_HIG=true
layout_spacing=4
layout_margin=4
submenu_delay=250

[GeneralColors]
window.color=#0d1018
window.light.color=#141926
base.color=#0f1320
base.light.color=#141926
alt.base.color=#111620
button.color=#1a1f2e
light.color=#2a3050
mid.light.color=#1e2538
dark.color=#080b12
mid.color=#111620
shadow.color=#000000
highlight.color=#388bfd
inactive.highlight.color=#2a5fa5
tooltip.base.color=#14192c
tooltip.text.color=#f0f6fc
text.color=#f0f6fc
window.text.color=#f0f6fc
button.text.color=#f0f6fc
disabled.text.color=#666688
tooltip.text=true
highlight.text.color=#ffffff
link.color=#58a6ff
link.visited.color=#bc8cff
progress.indicator.color=#388bfd
groove.color=#1a1f2e
selection.text.color=#ffffff

[Hacks]
transparent_ktitle_label=true
transparent_menutitle=false
respect_darkness=false
kcapacitybar_as_progressbar=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=100
lxqtmainmenu_iconsize=22
normal_default_pushbutton=false
single_top_toolbar=false
no_invert_selection=false
tint_on_mouseover=0
no_label_select=false
center_toolbar_handle=true
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=true
blurring=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=5
frame.right=5
interior=true
interior.element=button
indicator.size=10
text.iconspacing=4
indicator.top=0
indicator.bottom=0
indicator.left=0
indicator.right=0
text.normal.color=#f0f6fc
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.disabled.color=#666688

[PanelButtonTool]
inherits=PanelButtonCommand

[ToolbarButton]
inherits=PanelButtonCommand
